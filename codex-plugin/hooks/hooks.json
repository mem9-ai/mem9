{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\session-start.mjs\"",
            "timeout": 10,
            "statusMessage": "[mem9] session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\user-prompt-submit.mjs\"",
            "timeout": 20,
            "statusMessage": "[mem9] recall"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/stop.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\stop.mjs\"",
            "timeout": 20,
            "statusMessage": "[mem9] save"
          }
        ]
      }
    ]
  }
}
